{
  "name": "zammad-remote-mcp",
  "version": "1.1.0",
  "description": "Stateless remote MCP server for Zammad — full ticket operations, an intelligent search layer and OAuth 2.1, running on Node.js or Cloudflare Workers from one codebase.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "zammad",
    "mcp",
    "model-context-protocol",
    "helpdesk",
    "ticketing",
    "ai",
    "llm",
    "hono",
    "cloudflare-workers",
    "edge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JUVOJustin/zammad-remote-mcp.git"
  },
  "homepage": "https://github.com/JUVOJustin/zammad-remote-mcp#readme",
  "bugs": {
    "url": "https://github.com/JUVOJustin/zammad-remote-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "bin": {
    "zammad-remote-mcp": "./dist/node/index.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    ".env.example"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/node/index.ts",
    "start": "node dist/node/index.js",
    "build:worker": "npm run build && cd examples/cloudflare && npm install ../.. --no-save --silent && npm run build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "node --test --import tsx test/*.test.ts",
    "verify": "npm run check && npm run typecheck && npm test && npm run build:worker",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@hono/mcp": "^0.3.1",
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.32",
    "hono-rate-limiter": "^0.5.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
