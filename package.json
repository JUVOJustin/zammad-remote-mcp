{
  "name": "zammad-remote-mcp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server for Zammad — a runtime-agnostic core with thin Node.js and Cloudflare Workers packages.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "npm run dev --workspace @zammad-mcp/node",
    "dev:cf": "npm run dev --workspace @zammad-mcp/cloudflare",
    "verify": "npm run check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
