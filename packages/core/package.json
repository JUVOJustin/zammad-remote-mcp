{
  "name": "@zammad-mcp/core",
  "version": "1.0.0",
  "description": "Runtime-agnostic Zammad MCP server: Hono app, tools, search builder and stateless OAuth proxy. No Node built-ins.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx \"test/*.test.ts\""
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@hono/mcp": "^0.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.32",
    "hono-rate-limiter": "^0.5.3",
    "zod": "^4.4.3"
  },
  "keywords": [
    "zammad",
    "mcp",
    "model-context-protocol",
    "helpdesk",
    "ticketing",
    "ai",
    "llm",
    "hono",
    "cloudflare-workers",
    "edge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JUVOJustin/zammad-remote-mcp.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/JUVOJustin/zammad-remote-mcp#readme",
  "bugs": {
    "url": "https://github.com/JUVOJustin/zammad-remote-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.12"
  },
  "sideEffects": false
}
