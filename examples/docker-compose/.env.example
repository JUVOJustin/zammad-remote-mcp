# Two hostnames pointing at this host. Caddy gets certificates for both.
MCP_DOMAIN=mcp.example.com
ZAMMAD_DOMAIN=support.example.com

# --- OAuth (the default) ---------------------------------------------------
# Register an application in Zammad under Manage > Applications with the
# callback URI  https://<MCP_DOMAIN>/oauth/callback
ZAMMAD_OAUTH_CLIENT_ID=
ZAMMAD_OAUTH_CLIENT_SECRET=
# Signs the state parameter. Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=

# --- A single shared token instead of OAuth --------------------------------
# Every request then acts as that one Zammad user. Set these two and clear the
# three above.
#ZAMMAD_AUTH_MODE=token
#ZAMMAD_API_TOKEN=

# --- Local trial without DNS -----------------------------------------------
# Caddy issues locally-trusted certificates for *.localhost, so no public DNS is
# needed. Keep https: OAuth mode refuses a plain-HTTP issuer, so http:// here
# leaves the server restarting with "Issuer URL must be HTTPS".
#MCP_DOMAIN=mcp.localhost
#ZAMMAD_DOMAIN=support.localhost
#HTTPS_PORT=8443

# --- Optional --------------------------------------------------------------
#HTTP_PORT=80
#HTTPS_PORT=443
#ZAMMAD_VERSION=7.1.1-0037
#LOG_LEVEL=info
