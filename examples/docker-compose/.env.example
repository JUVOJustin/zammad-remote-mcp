# Where people reach this MCP server. Used for its OAuth callback and as the
# resource identifier clients verify, so it must be the address they connect to.
PUBLIC_URL=https://mcp.example.com

# Where a browser reaches Zammad. The MCP container itself uses the internal
# http://zammad-nginx:8080 and never needs this — the user approving access does.
ZAMMAD_PUBLIC_URL=https://support.example.com

# --- OAuth (the default) ---------------------------------------------------
# Register an OAuth application in Zammad under Manage > Applications with the
# callback URI  <PUBLIC_URL>/oauth/callback
ZAMMAD_OAUTH_CLIENT_ID=
ZAMMAD_OAUTH_CLIENT_SECRET=
# Signs the state parameter. Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=

# --- Single shared token instead of OAuth ----------------------------------
# Every request then acts as that one Zammad user. Set these two and clear the
# three above.
#ZAMMAD_AUTH_MODE=token
#ZAMMAD_API_TOKEN=

# --- Optional --------------------------------------------------------------
#MCP_EXPOSE_PORT=3000
#ZAMMAD_VERSION=7.1.1-0037
#LOG_LEVEL=info
# Zammad generates its own links from this; set it to your public hostname.
#NGINX_SERVER_SCHEME=https
