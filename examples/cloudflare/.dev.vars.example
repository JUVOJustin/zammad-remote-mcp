# Local Worker secrets. Copy to `.dev.vars` (gitignored) for `wrangler dev`.
# In production push the same names with `wrangler secret put <NAME>`.
# "Deploy to Cloudflare" reads this file to prompt for each value.

# --- ZAMMAD_AUTH_MODE=oauth (the default in wrangler.jsonc) -------------------
# Register the application in Zammad: admin panel → System → API → Applications.
# Callback URL: <PUBLIC_URL>/oauth/callback
ZAMMAD_OAUTH_CLIENT_ID = ""
ZAMMAD_OAUTH_CLIENT_SECRET = ""

# Signs registration/state and encrypts MCP credentials. Must be stable and
# identical across deployments; rotation invalidates existing authorizations.
#   openssl rand -base64 48
OAUTH_STATE_SECRET = ""

# --- ZAMMAD_AUTH_MODE=token (single-tenant instead) --------------------------
# Set ZAMMAD_AUTH_MODE=token in wrangler.jsonc and supply a Zammad access token
# instead of the three values above. OAuth then switches itself off. Also replace
# secrets.required in wrangler.jsonc with ["ZAMMAD_API_TOKEN"].
# ZAMMAD_API_TOKEN = ""
