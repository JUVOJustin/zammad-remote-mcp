# =============================================================================
# zammad-remote-mcp
# Copy to .env and adjust. Every value is validated at startup (src/config.ts);
# the process refuses to boot with a clear message if something is wrong.
# =============================================================================

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000

# Externally reachable base URL of THIS server. It forms the OAuth issuer, the
# callback URL and the `resource` identifier, so it must match what MCP clients
# actually dial (including scheme and port). Required when ZAMMAD_OAUTH_MODE=proxy.
PUBLIC_URL=https://mcp.example.com

# Path the MCP Streamable HTTP endpoint is mounted on.
MCP_PATH=/mcp

# debug | info | warn | error | silent   (logs go to stderr as JSON lines)
LOG_LEVEL=info

# Comma-separated CORS allowlist. `*` permits any origin.
CORS_ORIGINS=*

# --- Zammad ------------------------------------------------------------------
# Base URL of the Zammad instance, no trailing slash.
ZAMMAD_URL=https://support.example.com

# How this server authenticates against the Zammad REST API:
#   oauth  each MCP client sends its own Zammad access token as a bearer token
#          (default; multi-tenant, nothing stored server-side)
#   token  one fixed Zammad access token is used for every request
#   basic  a fixed username/password pair is used for every request
ZAMMAD_AUTH_MODE=oauth

# Only for ZAMMAD_AUTH_MODE=token
# ZAMMAD_API_TOKEN=

# Only for ZAMMAD_AUTH_MODE=basic (Zammad advises against it; prefer tokens)
# ZAMMAD_USERNAME=
# ZAMMAD_PASSWORD=

ZAMMAD_TIMEOUT_MS=30000
ZAMMAD_MAX_RETRIES=2

# --- OAuth -------------------------------------------------------------------
# Only meaningful when ZAMMAD_AUTH_MODE=oauth — that is the only mode in which
# the incoming bearer token is read. Leave it unset and it follows: `proxy`
# under `oauth`, `disabled` under `token`/`basic`. Setting it to proxy or
# passthrough alongside token/basic is rejected at startup, because the tokens
# it issued would be silently ignored.
#
# proxy        this server proxies /authorize and /token to Zammad, holds the
#              client secret and offers dynamic client registration (which
#              Zammad's Doorkeeper lacks). Recommended. Still stateless.
# passthrough  MCP clients talk to Zammad directly; every client redirect URI
#              must be registered in Zammad by hand.
# disabled     serve no OAuth metadata. Under ZAMMAD_AUTH_MODE=oauth this means
#              "bearer required, but discovery is handled by a gateway in front".
# ZAMMAD_OAUTH_MODE=proxy

# From Zammad's admin panel: System → API → Applications → New.
# Set "Callback URL" to the URL printed at startup: <PUBLIC_URL>/oauth/callback
# NOTE: Zammad leaves Doorkeeper's force_ssl_in_redirect_uri at its default, so a
# production instance REJECTS http:// callback URLs — including http://localhost.
# For local work either use ZAMMAD_AUTH_MODE=token, or give this server an https
# PUBLIC_URL via a tunnel/reverse proxy. See the README's local testing section.
ZAMMAD_OAUTH_CLIENT_ID=
ZAMMAD_OAUTH_CLIENT_SECRET=

# Doorkeeper's default scope in Zammad is `full`.
ZAMMAD_OAUTH_SCOPES=full

# Override only if Zammad is mounted under a sub-path.
# ZAMMAD_OAUTH_AUTHORIZE_PATH=/oauth/authorize
# ZAMMAD_OAUTH_TOKEN_PATH=/oauth/token
# ZAMMAD_OAUTH_REVOKE_PATH=/oauth/revoke

# Signs the `client_id` and the `state` parameter, which is what lets the proxy
# stay stateless. Required in proxy mode, min 16 chars. MUST be identical across
# replicas, and rotating it invalidates registered clients and in-flight logins.
#   generate with:  openssl rand -base64 48
OAUTH_STATE_SECRET=

# How long an authorization may take before the signed state expires.
OAUTH_STATE_TTL_SECONDS=600

# Guards against the proxy being used as an open redirector — the only thing
# stopping an attacker from registering a client that points at themselves.
# Loopback covers MCP clients running on the user's machine; claude.ai and
# claude.com are hosted clients that complete the flow on their own domain.
# Add a host here when a client is rejected with invalid_client_metadata.
OAUTH_ALLOWED_REDIRECT_HOSTS=localhost,127.0.0.1,[::1],claude.ai,claude.com
OAUTH_ALLOWED_REDIRECT_SCHEMES=http,https,vscode,cursor,claude

# --- Behaviour ---------------------------------------------------------------
# Verify the bearer token with GET /api/v1/users/me before the MCP handshake.
# Costs one extra round trip per request; off by default because an invalid
# token surfaces on the first tool call anyway.
VALIDATE_TOKEN_EAGERLY=false

# TTL for the in-process cache of groups/states/priorities and resolved
# user/organization lookups. Per-instance and per-credential; purely a latency
# optimisation, never required for correctness. 0 disables it.
METADATA_CACHE_TTL_SECONDS=300

# Hard ceiling on rows a single tool call may return.
MAX_PAGE_SIZE=100

# Fold this instance's own states, priorities, groups and macros into the tool
# input schemas as enums, so a model sees the valid values without a discovery
# call. Degrades to plain strings if a source is unreadable (an agent token gets
# 403 on admin endpoints) or Zammad is unreachable — tools/list never fails.
# Set to false to publish static schemas; tools/list then needs no Zammad call.
DYNAMIC_TOOL_SCHEMAS=true

# Above this many values the enum is omitted rather than truncated.
SCHEMA_ENUM_MAX_VALUES=150
